root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{kt,kts,swift}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{sh,py}]
indent_size = 4

[Makefile]
indent_style = tab
