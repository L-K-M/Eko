# Build output
build/
dist/
DerivedData/
*.xcarchive

# Gradle and Kotlin
.gradle/
.kotlin/
**/local.properties

# IDE and operating-system state
.idea/
.vscode/
*.iml
.DS_Store

# Xcode user state
*.xcuserstate
xcuserdata/

# Android captures
captures/

# Python bytecode. tools/ has its own copy of this; scripts/ arrived later and
# had none, so running scripts/check-protocol.py left .pyc files untracked.
__pycache__/
*.py[cod]

# Signing material and local credentials
*.jks
*.keystore
*.p12
*.mobileprovision
*.cer
*.key
*.env
.env.*
# ...but a committed template is the opposite of a leaked credential, and
# server/README.md opens by telling you to copy one. `.env.*` swallowed it.
!.env.example
!**/.env.example
*.profraw

# Relay server
server/target/
server/.env
server/*.db
server/*.db-wal
server/*.db-shm
