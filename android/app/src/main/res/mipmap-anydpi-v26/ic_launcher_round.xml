<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/eko_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Android 13+ themed icons. Without this layer Eko is one of the few icons on the
         home screen that refuses to tint. The system replaces the drawable's colour, so
         the foreground doubles as the monochrome silhouette. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
