    "device.forget.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird sofort vergessen, ohne das Telefon zu benachrichtigen. Verlauf und ausstehende Entkopplungsbestätigung werden gelöscht; das Telefon muss neu gekoppelt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be forgotten immediately without notifying the phone. Pairing history and the pending unpair receipt are deleted; the phone must pair again from scratch."
          }
        }
      }
    },
    "device.forget.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Benachrichtigung vergessen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget without notifying?"
          }
        }
      }
    },
