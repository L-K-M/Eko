# Copy to .env and edit. `docker compose` reads .env automatically.

# Required. Guards creation of the FIRST account, which is the one that becomes
# admin and claims the deployment.
#   openssl rand -base64 32
EKO_BOOTSTRAP_TOKEN=

# Leave EMPTY for normal use: registration is then governed by the admin
# toggle, which is the only setting that makes that toggle work.
#   open   - force open, admin toggle has no effect
#   closed - force closed, admin toggle has no effect, applies even to the
#            first account, and cannot be undone except by editing this file
EKO_REGISTRATION=

# Host port for the relay when not using the tls profile.
EKO_PORT=8080

# How long an undelivered envelope is kept. Far longer than the phone's 48 h
# window, which is the entire point of the relay.
EKO_RETENTION_DAYS=30

# Per-account ceiling on stored envelope bytes (default 512 MiB).
EKO_ACCOUNT_QUOTA_BYTES=536870912

# Only needed with `--profile tls`.
EKO_DOMAIN=relay.example.org

RUST_LOG=eko_relay=info,tower_http=warn
