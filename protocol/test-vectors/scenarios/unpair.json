            "welcome_sent": false
          }
        },
        {
          "from": "mac",
          "frame": {
            "type": "unpair",
            "unpair_id": "deadbeef-0000-4000-8000-000000000003",
            "initiator_id": "99ec855a2845f730cc5bf199568eeab3572210dc313520ac8780f22b5b9bb523",
            "peer_id": "1032bb16eb78521ee5e17d381b31e17c699fbda2cc5872e348551cfe1ae415c2",
            "reason": "user_request"
          }
        },
        {
          "from": "phone",
          "frame": {
            "type": "unpair_ack",
            "unpair_id": "deadbeef-0000-4000-8000-000000000003",
            "initiator_id": "99ec855a2845f730cc5bf199568eeab3572210dc313520ac8780f22b5b9bb523",
            "peer_id": "1032bb16eb78521ee5e17d381b31e17c699fbda2cc5872e348551cfe1ae415c2",
            "status": "applied"
          },
          "expect": {
            "phone_pairing_deleted": true,
            "mac_tombstone_deleted_after_ack": true,
            "sync_frames_exchanged": false
          }
        }
      ]
    }
  ]
}
